---
// The logo: a life ring in the signal color, as in the apps.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="0 0 32 32" fill="none" aria-hidden="true" class={className}>
  <circle cx="16" cy="16" r="10.5" stroke="var(--signal)" stroke-width="8"></circle>
  <circle
    cx="16"
    cy="16"
    r="10.5"
    stroke="var(--frame-ink)"
    stroke-width="8"
    stroke-dasharray="8.247 8.247"
    stroke-dashoffset="4.123"></circle>
</svg>
