---
// The logo: a life ring in the theme's signal color. Same as BrandMark.vue in the apps.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="0 0 32 32" fill="none" aria-hidden="true" class={className}>
  <circle cx="16" cy="16" r="10.5" class="stroke-primary" stroke-width="8"></circle>
  <circle
    cx="16"
    cy="16"
    r="10.5"
    class="stroke-neutral-content"
    stroke-width="8"
    stroke-dasharray="8.247 8.247"
    stroke-dashoffset="4.123"></circle>
</svg>
