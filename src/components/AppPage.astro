---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MorseSignal from './MorseSignal.astro';
import { getApp, latestRelease, type AppSlug } from '../data/apps';
import { langTags, localePath, messages, type Locale } from '../i18n';
import { appJsonLd } from '../lib/jsonld';

interface Props {
  locale: Locale;
  slug: AppSlug;
}

const { locale, slug } = Astro.props;
const t = messages[locale].ui;
const app = getApp(slug);
const text = messages[locale].apps[slug];
const jsonLd = appJsonLd({
  name: app.name,
  url: new URL(localePath(locale, `/${slug}/`), Astro.site).href,
  description: text.summary,
  inLanguage: langTags[locale],
  category: app.category,
  platforms: text.platforms,
  repo: app.repo,
});
const readme = locale === 'ko' ? `${app.repo}/blob/main/README.ko.md` : `${app.repo}#readme`;
---

<Base locale={locale} path={`/${slug}/`} title={app.name} description={text.summary} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl p-4 sm:p-8">
    <header class="py-8 sm:py-12">
      <div class="flex items-center gap-3">
        <Image src={app.icon} alt="" width={56} height={56} class="size-14" />
        <div>
          <p class="font-display text-xl">
            <span class="font-extrabold text-primary">SOS</span>{' '}
            <span class="font-medium">{app.name.replace('SOS ', '')}</span>
          </p>
          <p class="text-sm font-semibold text-base-content/60">{text.tagline}</p>
        </div>
      </div>
      <div class="mt-10"><MorseSignal /></div>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-6xl">
        {text.hookTitle}<br />
        <span class="text-primary">{text.hookAccent}</span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-base-content/70">{text.summary}</p>
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <a class="btn btn-primary btn-lg" href={latestRelease(app)}>{t.download}</a>
        <a class="btn btn-ghost btn-lg" href={app.repo}>{t.viewSource}</a>
      </div>
      <p class="mt-4 flex flex-wrap items-center gap-2 text-sm text-base-content/70">
        <span class="font-semibold text-base-content">{t.platforms}</span>
        {text.platforms.map((p) => <span class="badge border-base-300 bg-base-100">{p}</span>)}
      </p>
    </header>

    {app.images.length > 0 && (
      <section class="grid gap-4" aria-label={t.screenshots}>
        {
          app.images.map((image, i) => (
            <figure class="card card-border overflow-hidden bg-base-100">
              <Image
                src={image}
                alt={text.screenshots[i] ?? ''}
                widths={[640, 1280, 1920]}
                sizes="(min-width: 1024px) 976px, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="w-full"
              />
            </figure>
          ))
        }
      </section>
    )}

    <section class="py-12">
      <h2 class="text-2xl font-bold sm:text-3xl">{t.features}</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          text.features.map((f) => (
            <li class="card card-border bg-base-100">
              <div class="card-body gap-1">
                <h3 class="card-title text-lg">{f.title}</h3>
                <p class="text-base-content/70">{f.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="grid gap-4 pb-12 md:grid-cols-2">
      {app.needsApiKey && (
        <div role="note" class="alert alert-info alert-soft items-start">
          <div>
            <h2 class="font-bold">{t.requirementsHeading}</h2>
            <p class="mt-1">{t.requirements}</p>
          </div>
        </div>
      )}
      <div role="note" class:list={['alert alert-success alert-soft items-start', !app.needsApiKey && 'md:col-span-2']}>
        <div>
          <h2 class="font-bold">{t.privacyHeading}</h2>
          <p class="mt-1">{text.privacy}</p>
        </div>
      </div>
      <p class="text-base-content/70 md:col-span-2">
        {t.readme}{' '}
        <a href={readme} class="link font-semibold text-base-content">README</a>
      </p>
    </section>
  </div>
</Base>
