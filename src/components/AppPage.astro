---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MorseSignal from './MorseSignal.astro';
import { getApp, latestRelease, type AppSlug } from '../data/apps';
import { ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  slug: AppSlug;
}

const { locale, slug } = Astro.props;
const t = ui[locale];
const app = getApp(slug);
const text = app.text[locale];
const readme = locale === 'ko' ? `${app.repo}/blob/main/README.ko.md` : `${app.repo}#readme`;
---

<Base locale={locale} path={`/${slug}/`} title={app.name} description={text.summary}>
  <section class="mx-auto max-w-5xl px-4 pt-14 pb-12 sm:px-6 sm:pt-20">
    <div class="flex items-center gap-3">
      <Image src={app.icon} alt="" width={56} height={56} class="size-14" />
      <div>
        <p class="font-display text-xl font-bold">{app.name}</p>
        <p class="text-sm font-semibold text-signal-text">{text.tagline}</p>
      </div>
    </div>
    <div class="mt-10"><MorseSignal /></div>
    <h1 class="mt-5 text-4xl leading-[1.08] font-extrabold tracking-tight sm:text-6xl">
      {text.hookTitle}<br />
      <span class="text-signal-text">{text.hookAccent}</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">{text.summary}</p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href={latestRelease(app)}
        class="rounded-2xl bg-signal px-6 py-3 font-display text-lg font-bold text-signal-ink transition hover:brightness-105"
      >
        {t.download}
      </a>
      <a href={app.repo} class="rounded-2xl px-4 py-3 font-semibold underline-offset-4 hover:underline">
        {t.viewSource}
      </a>
    </div>
    <p class="mt-4 text-sm text-muted">
      <span class="font-semibold text-ink">{t.platforms}:</span>{' '}
      {text.platforms.join(' · ')}
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6" aria-label={t.screenshots}>
    <div class="grid gap-6">
      {
        app.images.map((image, i) => (
          <Image
            src={image}
            alt={text.screenshots[i]?.alt ?? ''}
            widths={[640, 1280, 1920]}
            sizes="(min-width: 1024px) 976px, 100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            class="w-full rounded-2xl border border-line shadow-xl shadow-black/5"
          />
        ))
      }
    </div>
  </section>

  <section class="border-t border-line bg-card/50">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-bold sm:text-3xl">{t.features}</h2>
      <ul class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          text.features.map((f) => (
            <li class="border-l-4 border-signal pl-4">
              <h3 class="text-lg font-bold">{f.title}</h3>
              <p class="mt-1 text-muted">{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto grid max-w-5xl gap-6 px-4 py-16 sm:px-6 md:grid-cols-2">
    <div class="rounded-3xl border border-line bg-card p-6">
      <h2 class="text-xl font-bold">{t.requirementsHeading}</h2>
      <p class="mt-2 text-muted">{t.requirements}</p>
    </div>
    <div class="rounded-3xl border border-line bg-card p-6">
      <h2 class="text-xl font-bold">{t.privacyHeading}</h2>
      <p class="mt-2 text-muted">{t.privacy}</p>
    </div>
    <p class="text-muted md:col-span-2">
      {t.readme}{' '}
      <a href={readme} class="font-semibold text-ink underline underline-offset-4">README</a>
    </p>
  </section>
</Base>
