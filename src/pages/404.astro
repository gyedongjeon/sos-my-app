---
import Base from '../layouts/Base.astro';
import MorseSignal from '../components/MorseSignal.astro';
import { localePath, messages } from '../i18n';

// GitHub Pages serves this page for every missing URL, whatever its language, so it speaks
// English with a Korean line under it and links to both.
const en = messages.en.ui;
const ko = messages.ko.ui;
---

<Base locale="en" path="/" title="404">
  <section class="mx-auto max-w-5xl p-4 py-16 sm:p-8 sm:py-24">
    <MorseSignal />
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-6xl">
      {en.notFoundTitle}<br />
      <span class="text-primary" lang="ko">{ko.notFoundTitle}</span>
    </h1>
    <p class="mt-6 text-lg text-base-content/70">{en.notFoundBody} <span lang="ko">{ko.notFoundBody}</span></p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={localePath('en')} class="btn btn-primary btn-lg">{en.backHome}</a>
      <a href={localePath('ko')} lang="ko" class="btn btn-ghost btn-lg">{ko.backHome}</a>
    </div>
  </section>
</Base>
