---
// Each app's page in every language but the default one, which is src/pages/<app>.astro.
import AppPage from '../../components/AppPage.astro';
import { apps, type AppSlug } from '../../data/apps';
import { prefixedLocales, type Locale } from '../../i18n';

export function getStaticPaths() {
  return prefixedLocales.flatMap((locale) => apps.map((app) => ({ params: { locale, app: app.slug } })));
}

const locale = Astro.params.locale as Locale;
const slug = Astro.params.app as AppSlug;
---

<AppPage locale={locale} slug={slug} />
